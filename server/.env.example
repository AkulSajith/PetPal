NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/petpal?schema=public"
PORT=4000
CLIENT_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Ollama Cloud credentials stay on the backend. Do not use a VITE_ prefix.
OLLAMA_API_KEY="replace-with-your-ollama-api-key"
OLLAMA_MODEL="replace-with-a-cloud-model-supported-by-your-account"
OLLAMA_BASE_URL="https://ollama.com/api"
OLLAMA_TIMEOUT_MS=30000

# Prototype chat limits. Use a shared rate-limit store before multi-instance deployment.
CHAT_HISTORY_MAX_MESSAGES=12
CHAT_MESSAGE_MAX_CHARS=2000
CHAT_REQUEST_MAX_CHARS=12000
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=12
