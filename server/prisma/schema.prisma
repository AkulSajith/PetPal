generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CARETAKER
  TRAINER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(OWNER)
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pets        Pet[]
  bookings    Booking[] @relation("UserBookings")
  trainer     Trainer?
  reviews     Review[]
  notifications Notification[]
}

model Pet {
  id           String   @id @default(cuid())
  ownerId      String
  name         String
  breed        String?
  age          Int?
  medicalNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  subscriptions PetFoodSubscription[]
  reviews      Review[]
}

model Booking {
  id           String        @id @default(cuid())
  petId        String
  providerId   String?
  ownerId      String
  serviceType  String
  bookingDate  DateTime
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner        User          @relation("UserBookings", fields: [ownerId], references: [id], onDelete: Cascade)
}

model Trainer {
  id            String   @id @default(cuid())
  userId        String   @unique
  specialization String?
  experience    String?
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews       Review[]
}

model Vet {
  id          String   @id @default(cuid())
  name        String
  clinic      String?
  location    String?
  contact     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PetEvent {
  id          String   @id @default(cuid())
  title       String
  location    String?
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PetFoodSubscription {
  id                 String   @id @default(cuid())
  petId              String
  foodType           String
  deliveryFrequency  String
  customization      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pet                Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  petId       String?
  trainerId   String?
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet         Pet?     @relation(fields: [petId], references: [id], onDelete: SetNull)
  trainer     Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}