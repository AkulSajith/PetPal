{
  "info": {
    "name": "PetPal Phase 2 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\"email\":\"admin@petpal.com\",\"password\":\"password123\"}" }
      }
    },
    {
      "name": "Create Pet",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/pets",
        "body": { "mode": "raw", "raw": "{\"name\":\"Buddy\",\"breed\":\"Indie\",\"age\":2,\"medicalNotes\":\"No known issues\"}" }
      }
    },
    {
      "name": "Create Booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": { "mode": "raw", "raw": "{\"petId\":1,\"serviceType\":\"BOARDING\",\"bookingDate\":\"2026-06-15\",\"amount\":1200}" }
      }
    }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:4000/api" }]
}
